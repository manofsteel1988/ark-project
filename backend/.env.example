# Base de données — SQLite en local (aucune installation requise)
# Pour la prod : DATABASE_URL="postgresql://user:password@host:5432/ark"
DATABASE_URL="file:./dev.db"

# Port du serveur API
PORT=4000

# Origine autorisée pour le front-end (CORS)
FRONTEND_ORIGIN="http://localhost:5500"

# Secret pour signer les tokens JWT (compte client) — à remplacer en prod
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="7d"
